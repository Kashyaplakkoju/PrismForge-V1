<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black">
    <com.pedro.library.view.OpenGlView android:id="@+id/surfaceView" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/streamChrome" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top">
            <LinearLayout android:id="@+id/topStatusHud" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_live_badge" android:padding="14dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:id="@+id/liveDot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_dot" app:tint="?attr/studioMuted" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/liveStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/studio_waiting_for_video" android:textColor="?attr/studioText" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:accessibilityLiveRegion="polite" />
                </LinearLayout>
                <TextView android:id="@+id/resolutionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/studio_select_this_phone_on_your_computer" android:textColor="?attr/studioMuted" android:textSize="12sp" />
                <TextView android:id="@+id/connectionTypeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/studio_connected" android:textColor="?attr/studioAccent" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMore" style="@style/StudioAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/studio_controls" android:tooltipText="@string/studio_camera_controls_and_streaming_help" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:id="@+id/bottomActionHud" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:padding="8dp" android:background="@drawable/bg_floating_hud">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSwitchCamera" style="@style/StudioAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="@string/studio_camera" app:icon="@drawable/ic_camera_switch" android:tooltipText="@string/studio_camera" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTorch" style="@style/StudioAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="@string/studio_torch" app:icon="@drawable/ic_flash_on" android:tooltipText="@string/studio_torch" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDimScreen" style="@style/StudioAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="@string/studio_dim" app:icon="@drawable/ic_brightness_dim" android:tooltipText="@string/studio_dim" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnStopStream" style="@style/StudioAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="@string/studio_stop" app:icon="@drawable/ic_stop_stream" android:tooltipText="@string/studio_stop_streaming_and_return_to_connection_screen" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <FrameLayout android:id="@+id/dimOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF000000" android:clickable="true" android:focusable="true" android:contentDescription="@string/studio_screen_dimmed_streaming_continues_double_tap_to_restore_screen_br" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/studio_screen_dimmed" android:textSize="20sp" android:textColor="#ADB5C9" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/studio_streaming_continues_tap_anywhere_to_return" android:textSize="14sp" android:textColor="#ADB5C9" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>